---
import { NAV, SITE } from "../data/site";
import Icon from "./Icon.astro";

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <img class="brand-logo" src="/images/drp-whiteback-logo.png" alt={`${SITE.name} logo`} width="40" height="40" loading="eager" decoding="async" />
      <span class="brand-copy">
        <span class="brand-name">{SITE.name}</span>
        <span class="brand-role">Full-stack developer</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        class="command-button"
        type="button"
        data-command-trigger
        aria-label="Search the site"
      >
        <Icon name="search" class="icon" />
        <span>Search</span>
        <kbd>⌘K</kbd>
      </button>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">
        <svg class="theme-toggle__icon theme-toggle__icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
        <span class="theme-toggle__label">Theme</span>
      </button>
      <span class="header-status">
        <span class="status-dot"></span>
        Available for work
      </span>
      <a class="btn btn--primary btn--small" href="/contact/">Start a project</a>
      <button
        class="nav-toggle"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-nav-toggle
      >
        <Icon name="menu" class="icon" data-menu-icon />
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-navigation" aria-label="Mobile navigation" data-mobile-nav>
    {NAV.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
        {item.label}
        <Icon name="arrow-up-right" class="icon" />
      </a>
    ))}
    <a href="/resume/">
      Résumé
      <Icon name="file" class="icon" />
    </a>
  </nav>
</header>

<script is:inline>
  const header = document.querySelector("[data-site-header]");
  const toggle = document.querySelector("[data-nav-toggle]");
  const mobileNav = document.querySelector("[data-mobile-nav]");
  const commandTrigger = document.querySelector("[data-command-trigger]");
  const themeToggle = document.querySelector("[data-theme-toggle]");

  const setHeaderState = () => {
    if (!header) return;
    header.classList.toggle("is-scrolled", window.scrollY > 12);
  };

  const setMenu = (open) => {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    toggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    mobileNav.classList.toggle("is-open", open);
    const icon = toggle.querySelector("svg");
    if (icon) icon.innerHTML = open
      ? '<path d="m6 6 12 12M18 6 6 18" />'
      : '<path d="M4 7h16M4 12h16M4 17h16" />';
  };

  const applyTheme = (theme) => {
    const root = document.documentElement;
    if (theme === "light") {
      root.setAttribute("data-theme", "light");
    } else if (theme === "dark") {
      root.removeAttribute("data-theme");
    } else {
      root.removeAttribute("data-theme");
    }
    try {
      localStorage.setItem("theme", theme === "light" ? "light" : "dark");
    } catch (e) {}
    const metaTheme = document.querySelector('meta[name="theme-color"]:not([media])');
    if (metaTheme) {
      metaTheme.setAttribute("content", theme === "light" ? "#f8f9fa" : "#07090b");
    }
  };

  const getCurrentTheme = () => {
    return document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
  };

  themeToggle?.addEventListener("click", () => {
    const next = getCurrentTheme() === "light" ? "dark" : "light";
    applyTheme(next);
  });

  setHeaderState();
  window.addEventListener("scroll", setHeaderState, { passive: true });

  toggle?.addEventListener("click", () => {
    setMenu(toggle.getAttribute("aria-expanded") !== "true");
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  commandTrigger?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("open-command-palette"));
  });
</script>
