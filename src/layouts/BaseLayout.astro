---
import "@fontsource-variable/manrope";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { getCollection } from "astro:content";
import { CATEGORY_LABELS, SITE, SKILL_GROUPS } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  pageType?: "WebPage" | "AboutPage" | "ContactPage" | "CollectionPage" | "ProfilePage" | "ItemPage";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = SITE.ogImage,
  type = "website",
  pageType = "WebPage",
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
} = Astro.props;

const isHome = Astro.url.pathname === "/";
const fullTitle = isHome ? `${SITE.name} | ${SITE.title}` : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;

const projects = await getCollection("projects", ({ data }) => !data.draft);
const paletteProjects = projects
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))
  .map((project) => ({
    title: project.data.title,
    summary: project.data.summary,
    category: CATEGORY_LABELS[project.data.category],
    href: `/projects/${project.id.replace(/\.mdx$/, "")}/`,
  }));

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE.url}/#person`,
  name: SITE.name,
  url: SITE.url,
  image: new URL(SITE.portrait, SITE.url).href,
  jobTitle: "Full Stack Developer",
  description: SITE.description,
  email: `mailto:${SITE.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Kathmandu",
    addressRegion: "Bagmati",
    addressCountry: "NP",
  },
  nationality: {
    "@type": "Country",
    name: "Nepal",
  },
  sameAs: [SITE.github, SITE.linkedin, SITE.x, SITE.npm],
  knowsAbout: [
    ...SKILL_GROUPS.flatMap((group) => group.items),
    "Full Stack Development",
    "Web Development",
    "Software Development Nepal",
    "AI Development",
    "ERP Systems",
  ],
  knowsLanguage: ["en", "ne", "hi"],
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Banke Bageshwori Campus",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Kalika Multiple Campus",
    },
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.description,
  inLanguage: "en",
  publisher: { "@id": `${SITE.url}/#person` },
};

const personPage = pageType === "ProfilePage" || pageType === "AboutPage" || pageType === "ContactPage";

const webpage = {
  "@context": "https://schema.org",
  "@type": pageType,
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  description,
  isPartOf: { "@id": `${SITE.url}/#website` },
  about: { "@id": `${SITE.url}/#person` },
  ...(personPage ? { mainEntity: { "@id": `${SITE.url}/#person` } } : {}),
  inLanguage: "en",
};

const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdItems = [person, website, webpage, ...extra];
const serialize = (value: unknown) => JSON.stringify(value).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f9fa" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <meta name="format-detection" content="telephone=no" />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/drp-logo.webp" type="image/webp" sizes="any" />
    <link rel="icon" href="/images/drp-whiteback-logo.png" type="image/png" sizes="any" />
    <link rel="apple-touch-icon" href="/images/drp-logo.webp" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} | ${SITE.title}`} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Darpan_3" />
    <meta name="twitter:creator" content="@Darpan_3" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={`${SITE.name} | ${SITE.title}`} />

    <script is:inline>
      document.documentElement.classList.add("js");
      (function() {
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          } else if (window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches) {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {}
      })();
    </script>
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={serialize(item)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CommandPalette projects={paletteProjects} client:load />

    <script is:inline>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) {
        document.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-visible"));
      } else if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
